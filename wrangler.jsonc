{
  "name": "inventech-demos",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Slows down password and PIN guessing: 10 attempts per minute per IP.
  "ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }]
  // Secrets (set in the Cloudflare dashboard, or .dev.vars locally): ADMIN_USER, ADMIN_PASSWORD, AUTH_SECRET
}
